{
  "name": "astryx-scientific-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run setup:cas",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "setup:cas": "node scripts/stage-cas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/engine.test.ts",
    "test:browser": "playwright test",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "prebuild": "npm run setup:cas",
    "build": "vite build",
    "postbuild": "node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@cortex-js/compute-engine": "0.170.0",
    "@fontsource-variable/figtree": "^5.2.0",
    "@stylexjs/stylex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "mathjs": "^15.0.0",
    "mathlive": "0.111.4",
    "nerdamer": "2.1.0",
    "plotly.js-dist-min": "^3.4.0",
    "pyodide": "0.29.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/plotly.js": "^3.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
